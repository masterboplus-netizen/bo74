    # === ДЛИТЕЛЬНОСТЬ (обработка ввода) ===
    if context.user_data.get('duration_step') == 'start':
        d = parse_date(text)
        if not d:
            await update.message.reply_text('❌ Не понял дату старта. Попробуй: «завтра», «1.10»')
