                    ])
                )
            except Exception:
                pass
        return True

    # --- СМЕТА ЭОМ ОБЪЕКТА ---
    if data.startswith("obj_elec_cost_"):
        try:
            object_id = int(data.replace("obj_elec_cost_", ""))
