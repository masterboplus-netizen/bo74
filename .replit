run = "venv/bin/python3 web_dashboard.py"
modules = ["nodejs-20", "python-3.11"]

[[ports]]
localPort = 8080
externalPort = 80

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "venv/bin/python3 web_dashboard.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "venv/bin/python3 bot.py"
