run = "venv/bin/python3 web_app.py"

[[ports]]
localPort = 8080
externalPort = 80

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "venv/bin/python3 web_app.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "venv/bin/python3 bot.py"
