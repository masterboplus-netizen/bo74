run = "venv/bin/python3 web_app.py"

[nix]
channel = "stable-25_05"
packages = ["python313Packages.fastapi", "python313Packages.uvicorn", "python313Packages.jinja2", "python313Packages.python-telegram-bot", "python313Packages.apscheduler", "python313Packages.reportlab", "python313Packages.openpyxl", "python313Packages.rapidfuzz"]

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "venv/bin/python3 web_app.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "venv/bin/python3 bot.py"
