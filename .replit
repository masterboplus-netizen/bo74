modules = ["nodejs-20", "python-base-3.13"]
run = "python main.py"

[nix]
channel = "stable-25_05"
packages = ["mailutils", "nano", "python313Packages.flask", "python313Packages.python-dotenv", "python313Packages.python-telegram-bot"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dashboard"

[[workflows.workflow]]
name = "Telegram Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Dashboard"
mode = "parallel"
author = 65448632

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_dashboard.py"

[[ports]]
localPort = 8080
externalPort = 80
