            reply_markup=InlineKeyboardMarkup(buttons)
        )
        return

    # === НАЗАД НА ПРЕДЫДУЩИЙ ШАГ ПРОЁМА ===
    if data.startswith("opening_back_"):
        parts = data.replace("opening_back_", "").split("_", 1)
        field = parts[0]
        room_id = int(parts[1])
        context.user_data['opening_room_id'] = room_id

        if field == 'width':
