                return
            elif first == 'rounded':
                context.user_data['waiting_for'] = 'wall_rounded_radius'
                await update.message.reply_text("🔄 *Закругление*\n\n📏 Радиус (СМ):", parse_mode=ParseMode.MARKDOWN)
                return
            elif first == 'wavy':
                context.user_data['waiting_for'] = 'wall_wavy_note'
