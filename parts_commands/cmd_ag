    c.execute("""
        SELECT DISTINCT o.id, o.name, COUNT(t.id) as cnt
        FROM objects o
        JOIN tasks t ON t.object_id = o.id
        WHERE t.status IN ('open', 'in_progress') AND o.status IN ('active', 'paused', 'waiting')
