        if amount:
            cb = f"choose_obj_{intent}_{o['id']}_{amount}_{category}"
        else:
            cb = f"choose_obj_{intent}_{o['id']}_none_none"
        buttons.append([InlineKeyboardButton(f"🏗️ {o['name']}", callback_data=cb)])
