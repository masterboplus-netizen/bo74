            except Exception:
                pass
            return
        kb = []
        for _a in _arch[:30]:
            _t = (_a.get("title") or "?")[:40]
            kb.append([InlineKeyboardButton("🗑 " + _t, callback_data=f"task_{_a["id"]}")])
        kb.append([InlineKeyboardButton("⬅️ К задачам", callback_data="menu_tasks")])
